# -- Running the app directly (npm run dev / npm start), not via Docker --
# PostgreSQL connection string
# Examples:
#   Local:  postgresql://user:password@localhost:5432/food_logbook
#   Neon:   postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/food_logbook?sslmode=require
#   Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/food_logbook

# Server port (optional, defaults to 5000)
PORT=5000

# Set to "false" to disable requiring SSL in production (e.g. a self-hosted
# Postgres reached over a private network, like the one docker-compose.yml
# runs alongside the app). Hosted providers (Railway, Neon, Supabase) need
# this left unset.
# DATABASE_SSL=false

# -- Running the full stack via `docker compose up` (see deploy/setup.sh) --
# Only DB_PASSWORD is needed; docker-compose.yml builds DATABASE_URL itself
# from it, pointed at the "db" container on the private Docker network.
# DB_PASSWORD=
